  "policy": {
    "definition": {
      "contract": "cost-intelligence.reporting.policy-definition",
      "schemaVersion": "1.0.0",
      "definitionId": "cdcbcf8d-56e4-4a57-8528-991ae8d74c49",
      "revision": 1,
      "reportingPolicyVersion": "ci08-reporting-policy-2.0.0",
      "accountingPolicyVersion": "ci06-accounting-policy-1.0.0",
      "allocationPolicyVersion": "ci06-allocation-policy-1.0.0",
      "definitionsStatus": "PENDING FINANCE-OWNER SIGN-OFF",
      "signMatrix": {
        "sale": {
          "grossSalesSign": 1,
          "netSalesSign": 1,
          "directCostsSign": 0,
          "cash": "none",
          "recovery": false,
          "note": "Recognized sale line; before discounts/refunds; excludes pass-through tax."
        },
        "discount": {
          "grossSalesSign": 0,
          "netSalesSign": -1,
          "directCostsSign": 0,
          "cash": "none",
          "recovery": false,
          "note": "Contra-revenue; reduces net sales only."
        },
        "refund:sale": {
          "grossSalesSign": 0,
          "netSalesSign": -1,
          "directCostsSign": 0,
          "cash": "none",
          "recovery": true,
          "note": "Sales refund linked to original sale; reduces net sales."
        },
        "refund:fee": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": -1,
          "cash": "none",
          "recovery": true,
          "note": "Fee refund; recovery linked to the original fee; reduces direct costs."
        },
        "credit": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": -1,
          "cash": "none",
          "recovery": true,
          "note": "Supplier/fee credit; recovery linked to its original cost category; reduces direct costs."
        },
        "reimbursement": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": -1,
          "cash": "none",
          "recovery": true,
          "note": "Reimbursement; recovery linked to its original cost category; reduces direct costs."
        },
        "tax": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": 0,
          "cash": "none",
          "recovery": false,
          "note": "Pass-through tax; excluded from gross and net sales."
        },
        "fee": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": 1,
          "cash": "none",
          "recovery": false,
          "note": "Applicable fee recognized as a direct cost under the documented policy."
        },
        "direct_cost": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": 1,
          "cash": "none",
          "recovery": false,
          "note": "Attributed AI / fulfillment / other direct expense."
        },
        "payout": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": 0,
          "cash": "payout",
          "recovery": false,
          "note": "Settlement transfer; cash only; never a new sale or expense."
        },
        "cash_movement": {
          "grossSalesSign": 0,
          "netSalesSign": 0,
          "directCostsSign": 0,
          "cash": "directional",
          "recovery": false,
          "note": "Cash receipt or payout; kept separate from accounting totals."
        }
      },
      "recognition": "live billing is actual even in test; sandbox and simulated billing remains separate simulation",
      "currency": "no cross-currency addition or unsourced conversion",
      "period": "economic root occurredAt in [start,end); ingestedAt and successors <= asOf",
      "coverage": "missing source is unknown; complete-zero requires scoped pinned evidence with expected zero observations",
      "denominator": "exact numerator/count ratio; current source-approved complete approval snapshot required; zero denominator is distinct from unknown",
      "allocation": "analytical only; source expense posted once; allocatedTotal plus residual equals source amount"
    },
    "reference": {
      "contract": "cost-intelligence.reporting.policy-definition",
      "schema_version": "1.0.0",
      "id": "cdcbcf8d-56e4-4a57-8528-991ae8d74c49",
      "revision": 1,
      "content_hash": "sha256:62ffb8e5e2723cde437e9fd3fe1e69c5383fe62874635afce6496c10982c47a0"
    }
  }
}
