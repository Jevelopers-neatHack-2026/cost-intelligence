{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/reporting/FinancialSummaryQuerySchema/2.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "scope",
    "period",
    "timezone",
    "policyVersion",
    "pageSize",
    "filters",
    "groupings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "idempotencyKey": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tenantId",
        "projectId",
        "environment",
        "billingMode",
        "actorId"
      ],
      "properties": {
        "tenantId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "projectId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "const": "development",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            },
            {
              "const": "production",
              "type": "string"
            }
          ]
        },
        "billingMode": {
          "anyOf": [
            {
              "const": "live",
              "type": "string"
            },
            {
              "const": "sandbox",
              "type": "string"
            },
            {
              "const": "simulated",
              "type": "string"
            }
          ]
        },
        "actorId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "period": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "format": "date-time",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "type": "string"
        }
      }
    },
    "timezone": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    },
    "policyVersion": {
      "const": "ci08-reporting-policy-2.0.0",
      "type": "string"
    },
    "requestedAsOf": {
      "format": "date-time",
      "type": "string"
    },
    "snapshotId": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "cursor": {
      "minLength": 1,
      "maxLength": 2048,
      "type": "string"
    },
    "pageSize": {
      "minimum": 1,
      "maximum": 500,
      "type": "integer"
    },
    "filters": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "environments",
        "billingModes"
      ],
      "properties": {
        "environments": {
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "development",
                "type": "string"
              },
              {
                "const": "test",
                "type": "string"
              },
              {
                "const": "production",
                "type": "string"
              }
            ]
          }
        },
        "billingModes": {
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "live",
                "type": "string"
              },
              {
                "const": "sandbox",
                "type": "string"
              },
              {
                "const": "simulated",
                "type": "string"
              }
            ]
          }
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "repositories": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "workstreams": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "providers": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "models": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "workflowIds": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "jobIds": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "featureCategories": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "orderIds": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "customerIds": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "products": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 256,
            "type": "string"
          }
        },
        "channels": {
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 256,
            "type": "string"
          }
        }
      }
    },
    "groupings": {
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "provider",
            "type": "string"
          },
          {
            "const": "model",
            "type": "string"
          },
          {
            "const": "feature",
            "type": "string"
          },
          {
            "const": "repo",
            "type": "string"
          },
          {
            "const": "workflowId",
            "type": "string"
          },
          {
            "const": "productId",
            "type": "string"
          },
          {
            "const": "orderId",
            "type": "string"
          },
          {
            "const": "channel",
            "type": "string"
          }
        ]
      }
    }
  }
}
