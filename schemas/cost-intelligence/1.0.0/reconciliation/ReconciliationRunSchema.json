{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/reconciliation/ReconciliationRunSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "runId",
    "status",
    "startedAt",
    "finishedAt",
    "sourceSnapshots",
    "scannedCount",
    "matchedCount",
    "unmatchedCount",
    "exceptionCount",
    "ownerReference",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "complete",
          "type": "string"
        },
        {
          "const": "needs_review",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "finishedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceSnapshots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "revision",
          "contentHash",
          "evidenceMode",
          "verificationStatus"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "minLength": 1,
            "type": "string"
          },
          "contentHash": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "evidenceMode": {
            "anyOf": [
              {
                "const": "mocked",
                "type": "string"
              },
              {
                "const": "sandbox",
                "type": "string"
              },
              {
                "const": "live",
                "type": "string"
              }
            ]
          },
          "verificationStatus": {
            "anyOf": [
              {
                "const": "verified",
                "type": "string"
              },
              {
                "const": "unverified",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "scannedCount": {
      "minimum": 0,
      "type": "integer"
    },
    "matchedCount": {
      "minimum": 0,
      "type": "integer"
    },
    "unmatchedCount": {
      "minimum": 0,
      "type": "integer"
    },
    "exceptionCount": {
      "minimum": 0,
      "type": "integer"
    },
    "ownerReference": {
      "minLength": 1,
      "type": "string"
    },
    "nextAction": {
      "minLength": 1,
      "type": "string"
    }
  }
}
