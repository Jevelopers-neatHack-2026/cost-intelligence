{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/pricing/EstimateResultSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "estimatedAt",
    "status",
    "knownSubtotal",
    "currency",
    "rateCardRef",
    "missingDimensions",
    "assumptions",
    "boundedConservativeAuthorizationAmount",
    "calculation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "estimatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "complete",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        },
        {
          "const": "stale",
          "type": "string"
        },
        {
          "const": "pricing_unknown",
          "type": "string"
        }
      ]
    },
    "knownSubtotal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 40,
      "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "rateCardRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "contract",
            "schema_version",
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "contract": {
              "minLength": 1,
              "type": "string"
            },
            "schema_version": {
              "const": "1.0.0",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "minimum": 0,
              "type": "integer"
            },
            "content_hash": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "missingDimensions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "assumptions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "boundedConservativeAuthorizationAmount": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
          "maxLength": 40,
          "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "calculation": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "quantity",
          "unit",
          "rate",
          "extendedAmount",
          "relation"
        ],
        "properties": {
          "category": {
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
            "maxLength": 40,
            "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "rate": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
            "maxLength": 40,
            "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
            "type": "string"
          },
          "extendedAmount": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
            "maxLength": 40,
            "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
            "type": "string"
          },
          "relation": {
            "anyOf": [
              {
                "const": "standalone",
                "type": "string"
              },
              {
                "const": "included_subset",
                "type": "string"
              },
              {
                "const": "unknown_relation",
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
