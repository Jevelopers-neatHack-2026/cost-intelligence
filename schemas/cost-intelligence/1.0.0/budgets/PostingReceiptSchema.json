{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/budgets/PostingReceiptSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "postingId",
    "status",
    "ledgerRevision",
    "originalPostingRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "postingId": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "applied",
          "type": "string"
        },
        {
          "const": "denied",
          "type": "string"
        },
        {
          "const": "stale",
          "type": "string"
        },
        {
          "const": "replay",
          "type": "string"
        },
        {
          "const": "conflict",
          "type": "string"
        }
      ]
    },
    "ledgerRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "originalPostingRef": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "contract",
        "schema_version",
        "id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "contract": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    }
  }
}
