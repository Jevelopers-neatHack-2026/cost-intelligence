{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/budgets/ReservationRequestSchema/1.0.0",
  "x-schema-completeness": "partial_wrapper_requires_combined_validation",
  "x-combined-validator": "validateReservationRequestBoundary",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "scope",
    "canonicalRequest",
    "estimate",
    "allowPartialAuthorization",
    "attemptBinding"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "idempotencyKey": {
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tenantId",
        "projectId",
        "environment",
        "billingMode",
        "actorId"
      ],
      "properties": {
        "tenantId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "projectId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "const": "development",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            },
            {
              "const": "production",
              "type": "string"
            }
          ]
        },
        "billingMode": {
          "anyOf": [
            {
              "const": "live",
              "type": "string"
            },
            {
              "const": "sandbox",
              "type": "string"
            },
            {
              "const": "simulated",
              "type": "string"
            }
          ]
        },
        "actorId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "canonicalRequest": {},
    "estimate": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "completeness",
        "knownSubtotal",
        "currency",
        "rateCardRef",
        "missingDimensions"
      ],
      "properties": {
        "completeness": {
          "anyOf": [
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "const": "incomplete",
              "type": "string"
            },
            {
              "const": "complete",
              "type": "string"
            }
          ]
        },
        "knownSubtotal": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
          "maxLength": 40,
          "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "rateCardRef": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "contract",
                "schema_version",
                "id",
                "revision",
                "content_hash"
              ],
              "properties": {
                "contract": {
                  "minLength": 1,
                  "type": "string"
                },
                "schema_version": {
                  "const": "1.0.0",
                  "type": "string"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "minimum": 0,
                  "type": "integer"
                },
                "content_hash": {
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "missingDimensions": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "boundedConservativeMaximum": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
          "maxLength": 40,
          "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
          "type": "string"
        },
        "maximumPolicyRef": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "contract",
            "schema_version",
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "contract": {
              "minLength": 1,
              "type": "string"
            },
            "schema_version": {
              "const": "1.0.0",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "minimum": 0,
              "type": "integer"
            },
            "content_hash": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        }
      }
    },
    "allowPartialAuthorization": {
      "type": "boolean"
    },
    "attemptBinding": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "logicalOperationId",
        "transportAttemptId",
        "providerRequestId",
        "providerAttemptId",
        "billableAttemptId"
      ],
      "properties": {
        "logicalOperationId": {
          "minLength": 1,
          "type": "string"
        },
        "transportAttemptId": {
          "minLength": 1,
          "type": "string"
        },
        "providerRequestId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerAttemptId": {
          "minLength": 1,
          "type": "string"
        },
        "billableAttemptId": {
          "minLength": 1,
          "type": "string"
        }
      }
    }
  }
}
