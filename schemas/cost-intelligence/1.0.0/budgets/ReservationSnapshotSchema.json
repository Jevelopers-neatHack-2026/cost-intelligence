{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/budgets/ReservationSnapshotSchema/1.0.0",
  "x-schema-completeness": "partial_wrapper_requires_combined_validation",
  "x-combined-validator": "validateReservationSnapshotBoundary",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "asOf",
    "reservation",
    "state",
    "heldAmount",
    "effectiveConsumedAmount",
    "releasedAmount",
    "latestCumulativeSettlement",
    "overrunAmount",
    "usageFinality",
    "expectedRevision",
    "attemptBinding"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "asOf": {
      "format": "date-time",
      "type": "string"
    },
    "reservation": {},
    "state": {
      "anyOf": [
        {
          "const": "held",
          "type": "string"
        },
        {
          "const": "dispatched",
          "type": "string"
        },
        {
          "const": "outcome_unknown",
          "type": "string"
        },
        {
          "const": "partially_settled",
          "type": "string"
        },
        {
          "const": "settled",
          "type": "string"
        },
        {
          "const": "released",
          "type": "string"
        },
        {
          "const": "expired",
          "type": "string"
        },
        {
          "const": "held_for_reconciliation",
          "type": "string"
        }
      ]
    },
    "heldAmount": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 40,
      "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
      "type": "string"
    },
    "effectiveConsumedAmount": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 40,
      "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
      "type": "string"
    },
    "releasedAmount": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 40,
      "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
      "type": "string"
    },
    "latestCumulativeSettlement": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 40,
      "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
      "type": "string"
    },
    "overrunAmount": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 40,
      "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
      "type": "string"
    },
    "usageFinality": {
      "anyOf": [
        {
          "const": "unknown",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "final",
          "type": "string"
        }
      ]
    },
    "expectedRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "attemptBinding": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "logicalOperationId",
        "transportAttemptId",
        "providerRequestId",
        "providerAttemptId",
        "billableAttemptId"
      ],
      "properties": {
        "logicalOperationId": {
          "minLength": 1,
          "type": "string"
        },
        "transportAttemptId": {
          "minLength": 1,
          "type": "string"
        },
        "providerRequestId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerAttemptId": {
          "minLength": 1,
          "type": "string"
        },
        "billableAttemptId": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "finance": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "revoked",
        "reservation_ref",
        "billable_attempt_id",
        "budget_scope_id",
        "lease_ref",
        "grant_ref",
        "tenant_id",
        "project_id",
        "account_ref",
        "project_ref",
        "provider",
        "model",
        "operation",
        "target_binding_sha256",
        "held_amount",
        "authorized_cap",
        "expires_at",
        "evidence_ref",
        "evidence_sha256"
      ],
      "properties": {
        "status": {
          "const": "held",
          "type": "string"
        },
        "revoked": {
          "const": false,
          "type": "boolean"
        },
        "reservation_ref": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "billable_attempt_id": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "budget_scope_id": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "lease_ref": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "grant_ref": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "tenant_id": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "account_ref": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "project_ref": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "target_binding_sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "held_amount": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
              "maxLength": 40,
              "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
              "type": "string"
            },
            "currency": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            }
          }
        },
        "authorized_cap": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
              "maxLength": 40,
              "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
              "type": "string"
            },
            "currency": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            }
          }
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    },
    "dispatchEligible": {
      "type": "boolean"
    },
    "commandOutcome": {
      "anyOf": [
        {
          "const": "applied",
          "type": "string"
        },
        {
          "const": "replay",
          "type": "string"
        },
        {
          "const": "stale_revision",
          "type": "string"
        },
        {
          "const": "conflict",
          "type": "string"
        }
      ]
    },
    "commandReceipt": {}
  }
}
