{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/metering/UsageObservationSchema/1.0.0",
  "x-schema-completeness": "partial_wrapper_requires_combined_validation",
  "x-combined-validator": "validateUsageObservationBoundary",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "scope",
    "usageEvent",
    "evidenceMode",
    "verificationStatus",
    "evidenceProvenanceRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "idempotencyKey": {
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tenantId",
        "projectId",
        "environment",
        "billingMode",
        "actorId"
      ],
      "properties": {
        "tenantId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "projectId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "const": "development",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            },
            {
              "const": "production",
              "type": "string"
            }
          ]
        },
        "billingMode": {
          "anyOf": [
            {
              "const": "live",
              "type": "string"
            },
            {
              "const": "sandbox",
              "type": "string"
            },
            {
              "const": "simulated",
              "type": "string"
            }
          ]
        },
        "actorId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "usageEvent": {},
    "evidenceMode": {
      "anyOf": [
        {
          "const": "mocked",
          "type": "string"
        },
        {
          "const": "sandbox",
          "type": "string"
        },
        {
          "const": "live",
          "type": "string"
        }
      ]
    },
    "verificationStatus": {
      "anyOf": [
        {
          "const": "verified",
          "type": "string"
        },
        {
          "const": "unverified",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    },
    "evidenceProvenanceRef": {
      "minLength": 1,
      "maxLength": 240,
      "type": "string"
    }
  }
}
